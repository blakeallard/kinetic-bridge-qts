# Local Supabase Postgres (kinetic-quote). Default matches `supabase status` DB_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# HTTP port for the local QTS app
PORT=8789

# Optional: absolute path to kit_bom/kit_components.csv (defaults to ../kit_bom/...)
# KIT_BOM_CSV=
