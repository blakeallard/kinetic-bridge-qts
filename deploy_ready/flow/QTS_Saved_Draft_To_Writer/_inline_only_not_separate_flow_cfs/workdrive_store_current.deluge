map workdrive_store_current(string current_folder_id, merged_file, string stable_filename)
{
result = Map();
result.put("status","skipped");
result.put("workdrive_file_id","");
result.put("folder","CURRENT");
safe_folder = ifnull(current_folder_id,"").trim();
safe_name = ifnull(stable_filename,"").trim();
if(safe_folder == "")
{
	result.put("status","failed");
	result.put("reason","folder_or_file_missing");
	return result;
}
if(merged_file == null)
{
	result.put("status","failed");
	result.put("reason","folder_or_file_missing");
	return result;
}
if(safe_name == "")
{
	safe_name = "Kinetic_Bridge_Quote.pdf";
}
try
{
	upload = invokeurl
	[
		url :"https://workdrive.zoho.com/api/v1/upload?parent_id=" + safe_folder + "&override-name-exist=true"
		type :POST
		files:merged_file
		connection:"flow_to_workdrive_full_access"
	];
	udata = ifnull(upload.get("data"),List());
	file_id = "";
	if(udata != null)
	{
		if(udata.size() > 0)
		{
			first = udata.get(0);
			attrs = ifnull(first.get("attributes"),Map());
			file_id = ifnull(attrs.get("resource_id"),ifnull(first.get("id"),"")).toString();
		}
	}
	if(file_id == "")
	{
		d = ifnull(upload.get("data"),Map());
		file_id = ifnull(d.get("id"),"").toString();
	}
	result.put("workdrive_file_id",file_id);
	result.put("filename",safe_name);
	result.put("status","ok");
}
catch (store_error)
{
	result.put("status","failed");
	result.put("reason","workdrive_store_current_failed");
}
return result;
}
