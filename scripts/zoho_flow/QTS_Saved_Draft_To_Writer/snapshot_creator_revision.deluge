map snapshot_creator_revision(string quote_request_id, string quote_number, map merge_data, map workdrive_folders)
{
result = Map();
result.put("status","skipped");
safe_id = ifnull(quote_request_id,"").trim();
safe_qno = ifnull(quote_number,"").trim();
revision = "1";
if(merge_data != null)
{
	revision = ifnull(merge_data.get("revision"),"1").toString().trim();
	if(revision == "") { revision = "1"; }
}
wd_current = "";
wd_confirmed = "";
wd_drafts = "";
if(workdrive_folders != null)
{
	wd_current = ifnull(workdrive_folders.get("current_id"),"").toString();
	wd_confirmed = ifnull(workdrive_folders.get("confirmed_id"),"").toString();
	wd_drafts = ifnull(workdrive_folders.get("drafts_id"),"").toString();
}
stamp = zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ssXXX","America/Los_Angeles");
info "snapshot_creator_revision: qno=" + safe_qno + " rev=" + revision + " quote_request_id=" + safe_id + " wd_current=" + wd_current + " wd_confirmed=" + wd_confirmed + " wd_drafts=" + wd_drafts + " at=" + stamp;
if(safe_id == "")
{
	result.put("status","ok");
	result.put("reason","no_quote_request_id_logged_only");
	return result;
}
try
{
	upd = Map();
	upd.put("Last_Published_At",stamp);
	result.put("status","ok");
	result.put("reason","logged_optional_fields_not_written");
	result.put("revision",revision);
	result.put("timestamp",stamp);
}
catch (snap_write_error)
{
	result.put("status","ok");
	result.put("reason","snapshot_write_skipped");
}
return result;
}
