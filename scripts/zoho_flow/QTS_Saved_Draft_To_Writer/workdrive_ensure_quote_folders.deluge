map workdrive_ensure_quote_folders(string quote_number, string parent_folder_id)
{
result = Map();
result.put("status","skipped");
result.put("reason","");
result.put("root_id","");
result.put("quote_folder_id","");
result.put("current_id","");
result.put("confirmed_id","");
result.put("drafts_id","");
qts_quotes_root_folder_id = "wctzef9e0b057e781406896d8866994e93156";
qts_quotes_root_folder_name = "QTS Quotes";
wd_connection = "zoho_crm_to_zoho_flow";
safe_qno = ifnull(quote_number,"").trim();
if(safe_qno == "")
{
	result.put("status","failed");
	result.put("reason","quote_number_missing");
	return result;
}
safe_parent = ifnull(parent_folder_id,"").trim();
root_id = qts_quotes_root_folder_id;
if(root_id == "" && safe_parent != "")
{
	try
	{
		listing = invokeurl
		[
			url :"https://workdrive.zoho.com/api/v1/files/" + safe_parent + "/files?filter[type]=folder&page%5Blimit%5D=50"
			type :GET
			connection:wd_connection
		];
		rows = ifnull(listing.get("data"),List());
		for each row in rows
		{
			attrs = ifnull(row.get("attributes"),Map());
			fname = ifnull(attrs.get("name"),"").toString();
			if(fname == qts_quotes_root_folder_name)
			{
				root_id = ifnull(row.get("id"),"").toString();
			}
		}
	}
	catch (root_lookup_error)
	{
		root_id = "";
	}
}
if(root_id == "")
{
	result.put("status","failed");
	result.put("reason","qts_quotes_root_not_found_set_QTS_QUOTES_ROOT_FOLDER_ID");
	return result;
}
result.put("root_id",root_id);
quote_folder_id = "";
current_id = "";
confirmed_id = "";
drafts_id = "";
try
{
	page_offset = 0;
	page_limit = 100;
	more_pages = true;
	while(more_pages && quote_folder_id == "")
	{
		q_listing = invokeurl
		[
			url :"https://workdrive.zoho.com/api/v1/files/" + root_id + "/files?filter[type]=folder&page%5Blimit%5D=" + page_limit.toString() + "&page%5Boffset%5D=" + page_offset.toString()
			type :GET
			connection:wd_connection
		];
		q_rows = ifnull(q_listing.get("data"),List());
		for each qrow in q_rows
		{
			qattrs = ifnull(qrow.get("attributes"),Map());
			if(ifnull(qattrs.get("name"),"").toString() == safe_qno)
			{
				quote_folder_id = ifnull(qrow.get("id"),"").toString();
			}
		}
		if(q_rows == null || q_rows.size() < page_limit)
		{
			more_pages = false;
		}
		else
		{
			page_offset = page_offset + page_limit;
			if(page_offset > 2000)
			{
				more_pages = false;
			}
		}
	}
	if(quote_folder_id == "")
	{
		create_body = Map();
		data_map = Map();
		data_map.put("type","files");
		attrs = Map();
		attrs.put("name",safe_qno);
		attrs.put("parent_id",root_id);
		data_map.put("attributes",attrs);
		create_body.put("data",data_map);
		created = invokeurl
		[
			url :"https://workdrive.zoho.com/api/v1/files"
			type :POST
			parameters:create_body.toString()
			connection:wd_connection
			content-type:"application/json"
		];
		cdata = ifnull(created.get("data"),Map());
		quote_folder_id = ifnull(cdata.get("id"),"").toString();
	}
}
catch (quote_folder_error)
{
	result.put("status","failed");
	result.put("reason","quote_folder_ensure_failed");
	return result;
}
if(quote_folder_id == "")
{
	result.put("status","failed");
	result.put("reason","quote_folder_id_blank");
	return result;
}
result.put("quote_folder_id",quote_folder_id);
sub_names = List();
sub_names.add("CURRENT");
sub_names.add("CONFIRMED");
sub_names.add("DRAFTS");
existing_subs = Map();
try
{
	s_listing = invokeurl
	[
		url :"https://workdrive.zoho.com/api/v1/files/" + quote_folder_id + "/files?filter[type]=folder&page%5Blimit%5D=50"
		type :GET
		connection:wd_connection
	];
	s_rows = ifnull(s_listing.get("data"),List());
	for each srow in s_rows
	{
		sattrs = ifnull(srow.get("attributes"),Map());
		existing_subs.put(ifnull(sattrs.get("name"),"").toString(),ifnull(srow.get("id"),"").toString());
	}
}
catch (sub_list_error)
{
}
for each sub_name in sub_names
{
	sid = ifnull(existing_subs.get(sub_name),"").toString();
	if(sid == "")
	{
		try
		{
			cbody = Map();
			dmap = Map();
			dmap.put("type","files");
			cattrs = Map();
			cattrs.put("name",sub_name);
			cattrs.put("parent_id",quote_folder_id);
			dmap.put("attributes",cattrs);
			cbody.put("data",dmap);
			cresp = invokeurl
			[
				url :"https://workdrive.zoho.com/api/v1/files"
				type :POST
				parameters:cbody.toString()
				connection:wd_connection
				content-type:"application/json"
			];
			cd = ifnull(cresp.get("data"),Map());
			sid = ifnull(cd.get("id"),"").toString();
		}
		catch (sub_create_error)
		{
			sid = "";
		}
	}
	if(sub_name == "CURRENT") { current_id = sid; }
	if(sub_name == "CONFIRMED") { confirmed_id = sid; }
	if(sub_name == "DRAFTS") { drafts_id = sid; }
}
result.put("current_id",current_id);
result.put("confirmed_id",confirmed_id);
result.put("drafts_id",drafts_id);
if(current_id == "" || drafts_id == "")
{
	result.put("status","failed");
	result.put("reason","current_or_drafts_folder_missing");
	return result;
}
result.put("status","ok");
return result;
}
