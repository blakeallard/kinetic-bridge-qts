// Creator workflow event: Form "Quote_Request" -> Quote_Lines subform ->
// field "Qty" -> On User Input.
//
// Paste this into that field's "On User Input" script box in the Creator Form
// Builder. Requires functions/fn_calc_line_price_draft.deluge and the already-
// patched functions/fn_get_tier_price.deluge to be deployed first (see
// docs/QUOTE_LINES_AUTOFILL_WORKFLOW_PLAN.md for exact order).
//
// Behavior: when a sales rep types/changes the quantity on a line, recalculates
// tier price (respecting Tier_Scheme via fn_get_tier_price.deluge), discount,
// markup, and FX conversion immediately, instead of waiting for Save.
//
// Falls back to a manually-typed Part_Number if Part_Select wasn't used for this
// line, matching the same dual-path pattern already used in
// functions/fn_calc_quote_lines.deluge.

if(input.Qty != null && input.Qty > 0)
{
	part = "";
	desc = ifnull(input.Description,"");
	if(input.Part_Select != null)
	{
		part = ifnull(input.Part_Select.Part_Number,"").toString();
	}
	if(part == "" || part == "null")
	{
		part = ifnull(input.Part_Number,"").toString();
	}

	if(part != "" && part != "null")
	{
		calc = thisapp.fn_calc_line_price_draft(
			part,
			input.Qty,
			desc,
			ifnull(input.Customer_Type,"End Customer"),
			ifnull(input.Currency,"USD"),
			ifnull(input.Markup_Rate_Pct,0),
			ifnull(input.FX_Charge_Mode,"non_usd_only")
		);
		input.Unit_Price = calc.get("unit_price");
		input.FX_Unit_Price = calc.get("fx_unit_price");
		input.Line_Total_USD = calc.get("line_total_usd");
		input.Line_Total_FX = calc.get("line_total_fx");
		input.Description = calc.get("description");
		// --- OPTIONAL: only uncomment once Quote_Lines.Discount/.Discountable are
		// confirmed to exist on the live subform — see
		// docs/QUOTE_LINES_AUTOFILL_WORKFLOW_PLAN.md "Confirm before deploying". ---
		// input.Discount = calc.get("discount");
		// input.Discountable = calc.get("discountable");
	}
}
