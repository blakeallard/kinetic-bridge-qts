// Creator workflow event: Form "Quote_Request" (parent form, not the subform) ->
// field "Currency" -> On User Input.
//
// Attach this SAME script body to the parent form's "FX_Charge_Mode" field's
// On User Input event too (both fields affect the same apply_fx/fx_rate decision
// — see fn_calc_quote_lines.deluge's identical branching logic) — do not
// duplicate the file, just wire both trigger fields to this one script.
//
// Behavior: when the customer currency (or FX charge mode) changes while the
// quote is still being drafted, recalculates FX_Unit_Price/Line_Total_FX for
// every existing Quote_Lines row from their ALREADY-COMPUTED Unit_Price/
// Line_Total_USD — it deliberately does NOT re-derive Unit_Price/Line_Total_USD
// or touch Description here. Those are driven by qty/tier/discount, which did
// not change just because Currency changed; recomputing them here would risk
// re-triggering the "[NO PRICE ON FILE]" Description marker logic a second time
// on lines that already have it, or masking a line that's mid-edit. Keeping this
// script narrowly scoped to the FX_* fields avoids that entirely.
//
// EUR_USD_Rate is not touched here either — it is Admin Only / system-computed by
// fn_calc_quote_lines.deluge on save and is not affected by Currency at all (it's
// always the EUR->USD base rate, independent of the customer-facing Currency).

currency = ifnull(input.Currency,"USD");
fx_mode = ifnull(input.FX_Charge_Mode,"non_usd_only");
apply_fx = false;
fx_rate = 1.0;

if((fx_mode == "non_usd_only" && currency != "USD") || fx_mode == "always")
{
	apply_fx = true;
	for each rate_rec in FX_Rates_Cache[Currency == currency]
	{
		fx_rate = ifnull(rate_rec.Rate,1);
		break;
	}
}

for each ln in input.Quote_Lines
{
	unit_price_usd = ifnull(ln.Unit_Price, 0);
	line_total_usd = ifnull(ln.Line_Total_USD, 0);
	if(apply_fx && fx_rate != 0)
	{
		ln.FX_Unit_Price = (unit_price_usd * fx_rate).round(2);
		ln.Line_Total_FX = (line_total_usd * fx_rate).round(2);
	}
	else
	{
		ln.FX_Unit_Price = unit_price_usd.round(2);
		ln.Line_Total_FX = line_total_usd.round(2);
	}
}
